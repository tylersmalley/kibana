{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "unicorn",
    "typescript",
    "oxc",
    "import",
    "jsx-a11y",
    "jest",
    "node",
    "promise",
    "react-perf"
  ],
  "categories": {},
  "rules": {
    "no-console": "off",
    "no-async-promise-executor": "warn",
    "no-unused-vars": [
      "warn",
      {
        "args": "none",
        "ignoreRestSiblings": true,
        "varsIgnorePattern": "^_"
      }
    ],
    "unicorn/no-abusive-eslint-disable": "warn",
    "no-restricted-imports": [
      "warn",
      {
        "paths": [
          {
            "name": "handlebars",
            "message": "Use @kbn/handlebars instead."
          },
          {
            "name": "enzyme",
            "message": "Enzyme is deprecated and no longer maintained. Please use @testing-library/react instead."
          },
          {
            "name": "expect.js",
            "message": "Import from \"@kbn/expect\" instead of \"expect.js\"."
          },
          {
            "name": "mkdirp",
            "message": "Don't use 'mkdirp', use the new { recursive: true } option of Fs.mkdir instead"
          },
          {
            "name": "numeral",
            "message": "Import from \"@elastic/numeral\" instead of \"numeral\"."
          },
          {
            "name": "@kbn/elastic-idx",
            "message": "Don't use idx(), use optional chaining syntax instead https://ela.st/optchain"
          },
          {
            "name": "x-pack",
            "message": "Use a relative import instead of \"x-pack\"."
          },
          {
            "name": "react-router",
            "message": "Import from \"react-router-dom\" instead of \"react-router\"."
          },
          {
            "name": "@kbn/ui-shared-deps/monaco",
            "message": "Import from \"@kbn/monaco\" instead of \"@kbn/ui-shared-deps/monaco\"."
          },
          {
            "name": "monaco-editor",
            "message": "Don't import monaco directly, use or add exports to @kbn/monaco"
          },
          {
            "name": "tinymath",
            "message": "Don't use 'tinymath', use '@kbn/tinymath'"
          },
          {
            "name": "@kbn/test/types/ftr",
            "message": "import from the root of @kbn/test instead"
          },
          {
            "name": "@kbn/test/jest",
            "message": "import from @kbn/test-jest-helpers instead"
          },
          {
            "name": "@kbn/utility-types/jest",
            "message": "import from @kbn/utility-types-jest instead"
          },
          {
            "name": "@kbn/inspector-plugin",
            "message": "Import from \"@kbn/inspector-plugin/common\" instead of \"@kbn/inspector-plugin\"."
          },
          {
            "name": "@kbn/expressions-plugin",
            "message": "Import from \"@kbn/expressions-plugin/common\" instead of \"@kbn/expressions-plugin\"."
          },
          {
            "name": "@kbn/kibana-utils-plugin",
            "message": "Import from \"@kbn/kibana-utils-plugin/common\" instead of \"@kbn/kibana-utils-plugin\"."
          },
          {
            "name": "@elastic/safer-lodash-set",
            "message": "Import from \"@kbn/safer-lodash-set\" instead of \"@elastic/safer-lodash-set\"."
          },
          {
            "name": "@elastic/apm-synthtrace",
            "message": "Import from \"@kbn/synthtrace\" instead of \"@elastic/apm-synthtrace\"."
          },
          {
            "name": "rison-node",
            "message": "Import from \"@kbn/rison\" instead of \"rison-node\"."
          },
          {
            "name": "react-dom/client",
            "message": "Use `react-dom` instead of `react-dom/client` until upgraded to React 18"
          },
          {
            "name": "@tanstack/react-query",
            "message": "Use `@kbn/react-query` instead of `@tanstack/react-query`, as it defaults to networkMode=\"always\""
          },
          {
            "name": "@kbn/dev-utils",
            "importNames": [
              "DEFAULT_LOG_LEVEL",
              "getLogLevelFlagsHelp",
              "LOG_LEVEL_FLAGS",
              "LogLevel",
              "Message",
              "ParsedLogLevel",
              "parseLogLevel",
              "pickLevelFromFlags",
              "ToolingLog",
              "ToolingLogCollectingWriter",
              "ToolingLogOptions",
              "ToolingLogTextWriter",
              "ToolingLogTextWriterConfig",
              "Writer"
            ],
            "message": "Import moved exports from \"@kbn/tooling-log\" instead."
          },
          {
            "name": "@kbn/dev-utils",
            "importNames": [
              "CiStatsMetric",
              "CiStatsReporter",
              "CiStatsReportTestsOptions",
              "CiStatsTestGroupInfo",
              "CiStatsTestResult",
              "CiStatsTestRun",
              "CiStatsTestType",
              "CiStatsTiming",
              "getTimeReporter",
              "MetricsOptions",
              "TimingsOptions"
            ],
            "message": "Import moved exports from \"@kbn/ci-stats-reporter\" instead."
          },
          {
            "name": "@kbn/dev-utils",
            "importNames": [
              "Config"
            ],
            "message": "Import moved exports from \"@kbn/ci-stats-core\" instead."
          },
          {
            "name": "@kbn/dev-utils",
            "importNames": [
              "createAbsolutePathSerializer",
              "createStripAnsiSerializer",
              "createRecursiveSerializer",
              "createAnyInstanceSerializer",
              "createReplaceSerializer"
            ],
            "message": "Import moved exports from \"@kbn/jest-serializers\" instead."
          },
          {
            "name": "@kbn/dev-utils",
            "importNames": [
              "observeReadable",
              "observeLines"
            ],
            "message": "Import moved exports from \"@kbn/stdio-dev-helpers\" instead."
          },
          {
            "name": "@kbn/dev-utils",
            "importNames": [
              "sortPackageJson"
            ],
            "message": "Import moved exports from \"@kbn/sort-package-json\" instead."
          },
          {
            "name": "@kbn/dev-utils",
            "importNames": [
              "run",
              "Command",
              "RunWithCommands",
              "CleanupTask",
              "CommandRunFn",
              "FlagOptions",
              "Flags",
              "RunContext",
              "RunFn",
              "RunOptions",
              "RunWithCommandsOptions",
              "getFlags",
              "mergeFlagOptions"
            ],
            "message": "Import moved exports from \"@kbn/dev-cli-runner\" instead."
          },
          {
            "name": "@kbn/dev-utils",
            "importNames": [
              "createFailError",
              "createFlagError",
              "isFailError"
            ],
            "message": "Import moved exports from \"@kbn/dev-cli-errors\" instead."
          },
          {
            "name": "@kbn/dev-utils",
            "importNames": [
              "withProcRunner",
              "ProcRunner"
            ],
            "message": "Import moved exports from \"@kbn/dev-proc-runner\" instead."
          },
          {
            "name": "@kbn/utils",
            "importNames": [
              "REPO_ROOT",
              "UPSTREAM_BRANCH",
              "kibanaPackageJson",
              "isKibanaDistributable",
              "fromRoot"
            ],
            "message": "Import moved exports from \"@kbn/repo-info\" instead."
          },
          {
            "name": "@kbn/presentation-util-plugin/common",
            "importNames": [
              "functionWrapper",
              "fontStyle"
            ],
            "message": "Import moved exports from \"@kbn/presentation-util-plugin/test_helpers\" instead."
          },
          {
            "name": "@kbn/fleet-plugin/common",
            "importNames": [
              "createFleetAuthzMock"
            ],
            "message": "Import moved exports from \"@kbn/fleet-plugin/common/mocks\" instead."
          }
        ],
        "patterns": [
          {
            "group": [
              "handlebars/*"
            ],
            "message": "Use @kbn/handlebars instead."
          },
          {
            "group": [
              "expect.js/*"
            ],
            "message": "Import from \"@kbn/expect/*\" instead of \"expect.js/*\"."
          },
          {
            "group": [
              "mkdirp/*"
            ],
            "message": "Don't use 'mkdirp', use the new { recursive: true } option of Fs.mkdir instead"
          },
          {
            "group": [
              "numeral/*"
            ],
            "message": "Import from \"@elastic/numeral/*\" instead of \"numeral/*\"."
          },
          {
            "group": [
              "@kbn/elastic-idx/*"
            ],
            "message": "Don't use idx(), use optional chaining syntax instead https://ela.st/optchain"
          },
          {
            "group": [
              "x-pack/*"
            ],
            "message": "Use a relative import instead of \"x-pack/*\"."
          },
          {
            "group": [
              "react-router/*"
            ],
            "message": "Import from \"react-router-dom/*\" instead of \"react-router/*\"."
          },
          {
            "group": [
              "@kbn/ui-shared-deps/monaco/*"
            ],
            "message": "Import from \"@kbn/monaco/*\" instead of \"@kbn/ui-shared-deps/monaco/*\"."
          },
          {
            "group": [
              "monaco-editor/*"
            ],
            "message": "Don't import monaco directly, use or add exports to @kbn/monaco"
          },
          {
            "group": [
              "tinymath/*"
            ],
            "message": "Don't use 'tinymath', use '@kbn/tinymath'"
          },
          {
            "group": [
              "@kbn/test/types/ftr/*"
            ],
            "message": "import from the root of @kbn/test instead"
          },
          {
            "group": [
              "@kbn/test/jest/*"
            ],
            "message": "import from @kbn/test-jest-helpers instead"
          },
          {
            "group": [
              "@kbn/utility-types/jest/*"
            ],
            "message": "import from @kbn/utility-types-jest instead"
          },
          {
            "group": [
              "@elastic/safer-lodash-set/*"
            ],
            "message": "Import from \"@kbn/safer-lodash-set/*\" instead of \"@elastic/safer-lodash-set/*\"."
          },
          {
            "group": [
              "@elastic/apm-synthtrace/*"
            ],
            "message": "Import from \"@kbn/synthtrace/*\" instead of \"@elastic/apm-synthtrace/*\"."
          },
          {
            "group": [
              "rison-node/*"
            ],
            "message": "Import from \"@kbn/rison/*\" instead of \"rison-node/*\"."
          },
          {
            "regex": "^(?!\\.?\\.?/).+/$",
            "message": "Using a trailing slash in package import statements causes issues with webpack and is inconsistent with the rest of the repository."
          }
        ]
      }
    ],
    "unicorn/no-array-for-each": "warn",
    "@kbn/disable/no_protected_eslint_disable": "error",
    "@kbn/eslint/no_constructor_args_in_property_initializers": "error",
    "@kbn/eslint/no_this_in_property_initializers": "error",
    "@kbn/eslint/no_unsafe_console": "error",
    "@kbn/eslint/no_unsafe_hash": "error",
    "@kbn/eslint/no_wrapped_error_in_logger": "error"
  },
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "overrides": [
    {
      "files": [
        "src/core/{server,public,common}/index.ts",
        "src/platform/plugins/**/{server,public,common}/index.ts",
        "x-pack/platform/plugins/**/{server,public,common}/index.ts",
        "x-pack/solutions/*/plugins/**/{server,public,common}/index.ts"
      ],
      "rules": {
        "oxc/no-barrel-file": [
          "warn",
          {
            "threshold": 0
          }
        ]
      }
    },
    {
      "files": [
        "src/platform/plugins/**/test/{scout,scout_*}/api/**/*.ts",
        "x-pack/platform/**/plugins/**/test/{scout,scout_*}/api/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "warn",
          {
            "paths": [

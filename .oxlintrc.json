                "name": "@kbn/scout",
                "importNames": [
                  "expect"
                ],
                "message": "Import `expect` from '@kbn/scout/api' in Scout API tests."
              },
              {
                "name": "@kbn/scout/ui",
                "importNames": [
                  "expect"
                ],
                "message": "Import `expect` from '@kbn/scout/api' in Scout API tests."
              },
              {
                "name": "@playwright/test",
                "importNames": [
                  "expect"
                ],
                "message": "Import `expect` from '@kbn/scout/api' in Scout API tests."
              },
              {
                "name": "playwright",
                "importNames": [
                  "expect"
                ],
                "message": "Import `expect` from '@kbn/scout/api' in Scout API tests."
              }
            ]
          }
        ]
      }
    },
    {
